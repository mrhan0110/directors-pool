# 복사해서 .streamlit/secrets.toml 로 사용
# 실제 secrets.toml 은 .gitignore 처리되어 있다. 절대 커밋하지 말 것 (PRD F-09-20)

[database]
url = "sqlite:///./storage/pool_dev.db"

[collectors]
# 참고: 코드는 현재 이 파일이 아니라 환경변수(os.getenv, .env)만 읽는다 — 아래 값은
# 실제 배포에서 st.secrets 연동을 추가할 경우를 대비한 참고용 템플릿이다.
dart_api_key = ""
naver_client_id = ""
naver_client_secret = ""

# 3.5단계 SSO 연동 시 사용 (PRD F-09-10)
[auth.oidc]
issuer = ""
client_id = ""
client_secret = ""
redirect_uri = ""
