# 복사해서 .streamlit/secrets.toml 로 사용
# 실제 secrets.toml 은 .gitignore 처리되어 있다. 절대 커밋하지 말 것 (PRD F-09-20)

[database]
url = "sqlite:///./storage/pool_dev.db"

[collectors]
dart_api_key = ""
news_api_key = ""

# 3.5단계 SSO 연동 시 사용 (PRD F-09-10)
[auth.oidc]
issuer = ""
client_id = ""
client_secret = ""
redirect_uri = ""
