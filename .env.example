# 복사해서 .env 로 사용 (.env 는 커밋 금지)

# 개발: SQLite / 운영: PostgreSQL (PRD §8)
DATABASE_URL=sqlite:///./storage/pool_dev.db

# 데이터 모드: dummy | live
# dummy = 합성 더미데이터만 사용. 개발/테스트 기본값이며 실명 데이터 사용 금지 (PRD 불변규칙 6)
DATA_MODE=dummy

# 인증 프로바이더: mock | oidc
# 1단계는 mock 고정. oidc 는 3.5단계에서 연동 (PRD F-09-10)
AUTH_PROVIDER=mock

# 원문 스냅샷 저장 경로 (PRD F-05-6)
SNAPSHOT_DIR=./storage/snapshots

# 2단계 수집기에서 사용. 코드에 하드코딩 금지 (PRD F-09-20)
DART_API_KEY=
NEWS_API_KEY=
